generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model EventConfig {
  id              String   @id
  eventName       String
  timezone        String
  schemaVersion   String
  appVersion      String
  dataLocation    String
  catalogRevision Int      @default(1)
  storageEpoch    Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id        String             @id
  code      String             @unique
  label     String
  enabled   Boolean            @default(true)
  revision  Int                @default(1)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  groups    CompetitionGroup[]
  teams     Team[]
  matches   Match[]
  timerConfigs TimerConfig[]
  tieConfigs TieConfig[]
}

model CompetitionGroup {
  id         String            @id
  categoryId String
  name       String
  enabled    Boolean           @default(true)
  revision   Int               @default(1)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  members    GroupMembership[] @relation("MembershipGroupCategory")
  matches    Match[]

  @@unique([id, categoryId])
  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("Group")
}

model Team {
  id          String            @id
  categoryId  String
  code        String
  name        String
  institution String?
  archivedAt  DateTime?
  revision    Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships GroupMembership[] @relation("MembershipTeamCategory")
  matchesAsTeamA Match[]        @relation("MatchTeamA")
  matchesAsTeamB Match[]        @relation("MatchTeamB")
  matchParticipants MatchParticipant[]

  @@unique([id, categoryId])
  @@unique([categoryId, code])
  @@index([categoryId])
}

model GroupMembership {
  id         String           @id
  categoryId String
  groupId    String
  teamId     String
  createdAt  DateTime         @default(now())
  group      CompetitionGroup @relation("MembershipGroupCategory", fields: [groupId, categoryId], references: [id, categoryId], onDelete: Restrict, onUpdate: Cascade)
  team       Team             @relation("MembershipTeamCategory", fields: [teamId, categoryId], references: [id, categoryId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([categoryId, teamId])
  @@unique([groupId, teamId])
  @@index([groupId])
  @@index([teamId])
}

model User {
  id           String       @id
  username     String       @unique
  passwordHash String
  role         String
  enabled      Boolean      @default(true)
  revision     Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  auditEntries AuditEntry[]
}

model Session {
  id          String   @id
  userId      String
  sessionHash String   @unique
  csrfHash    String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditEntry {
  id                 String   @id
  commandId          String?
  actorId             String?
  timestampUtc        DateTime @default(now())
  action              String
  resourceType        String
  resourceId          String?
  beforeJson          String?
  afterJson           String?
  reason              String?
  authorityReference  String?
  actor               User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([commandId])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([timestampUtc])
}

model OperationLedger {
  id                String          @id
  principalId       String
  scope             String
  idempotencyKey    String
  payloadHash       String
  targetId          String?
  expectedRuntimeId String?
  status            String
  terminalCode      String?
  receiptJson       String?
  reservedAt        DateTime        @default(now())
  terminalAt        DateTime?
  receipt           CommandReceipt?

  @@unique([principalId, scope, idempotencyKey])
  @@index([status, reservedAt])
}

model CommandReceipt {
  id          String          @id
  ledgerId    String          @unique
  responseJson String
  committedAt DateTime        @default(now())
  ledger      OperationLedger @relation(fields: [ledgerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([committedAt])
}

model OutboxEvent {
  eventId             String    @id
  broadcastRevision   Int       @unique
  aggregateType       String
  aggregateId         String
  type                 String
  payloadPublicJson    String
  committedAt          DateTime  @default(now())
  dispatchedAt         DateTime?

  @@index([dispatchedAt, committedAt])
  @@index([aggregateType, aggregateId])
}

model BackupManifest {
  backupId                String    @id
  createdAt               DateTime  @default(now())
  schemaVersion           String
  appVersion              String
  sha256                  String
  fileSize                Int
  lastCommittedCommandAt  DateTime?
  lastCheckpointAt        DateTime?
  backupCutCommandId      String?
  backupCutCommandAt      DateTime?
  eventSessionId          String?
  eventSessionClosedAt    DateTime?
  verifiedAt              DateTime?
  copiedToSecondMediaAt   DateTime?
  storageEpoch            Int
  restoreLineage          String
  verifyStatus            String
}

model Match {
  id                String            @id
  categoryId        String
  groupId           String?
  stage             String            @default("GROUP")
  stageLabel        String?
  scheduledAt       DateTime?
  sequence          Int
  teamAId           String
  teamBId           String
  status            String            @default("SCHEDULED")
  phase             String?
  resumePhase       String?
  matchVersion      Int               @default(1)
  hasStarted        Boolean           @default(false)
  currentSegmentId  String?
  teamASnapshotJson String?
  teamBSnapshotJson String?
  tieId             String?
  rondeNumber       Int?
  generationBatchId String?
  bracketSlot       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  group             CompetitionGroup? @relation(fields: [groupId, categoryId], references: [id, categoryId], onDelete: Restrict, onUpdate: Cascade)
  teamA             Team              @relation("MatchTeamA", fields: [teamAId, categoryId], references: [id, categoryId], onDelete: Restrict, onUpdate: Cascade)
  teamB             Team              @relation("MatchTeamB", fields: [teamBId, categoryId], references: [id, categoryId], onDelete: Restrict, onUpdate: Cascade)
  generationBatch   MatchGenerationBatch? @relation(fields: [generationBatchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  activeInArena     ArenaState?       @relation("ArenaActiveMatch")
  participants      MatchParticipant[]
  segments          SegmentAttempt[]
  goals             GoalEvent[]
  results           ResultRevision[]
  timerInstances    TimerInstance[]
  goalIntents       GoalIntent[]

  @@unique([categoryId, sequence])
  @@unique([tieId, rondeNumber])
  @@index([categoryId])
  @@index([groupId])
  @@index([teamAId])
  @@index([teamBId])
  @@index([status])
  @@index([sequence])
  @@index([generationBatchId])
}

model TieConfig {
  id          String   @id
  categoryId  String
  stage       String
  rondeCount  Int
  approvedBy  String?
  sourceNote  String?
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([categoryId, stage])
  @@index([categoryId])
}

model MatchGenerationBatch {
  id           String   @id
  categoryId   String
  stage        String
  rondeCount   Int
  stageLabel   String?
  createdCount Int
  actorId      String?
  createdAt    DateTime @default(now())
  rolledBackAt DateTime?
  matches      Match[]

  @@index([categoryId])
  @@index([rolledBackAt])
}

model ArenaState {
  id            String   @id // 'main'
  activeMatchId String?  @unique
  arenaVersion  Int      @default(1)
  updatedAt     DateTime @updatedAt
  activeMatch   Match?   @relation("ArenaActiveMatch", fields: [activeMatchId], references: [id], onDelete: SetNull, onUpdate: Cascade)
}

model MatchParticipant {
  id           String   @id
  matchId      String
  side         String   // 'A' | 'B'
  teamId       String
  attendance   String   @default("UNKNOWN") // 'UNKNOWN', 'PRESENT', 'ABSENT'
  verification String   @default("PENDING") // 'PENDING', 'READY', 'NOT_READY', 'FAILED'
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([matchId, side])
  @@index([matchId])
  @@index([teamId])
}

model SegmentAttempt {
  id                  String      @id
  matchId             String
  kind                String      // 'START', 'ROUND', 'HALF'
  ordinal             Int         // 1, 2, ...
  attempt             Int         // 1, 2, ...
  supersedesAttemptId String?
  status              String      @default("PREPARED") // 'PREPARED', 'ACTIVE', 'ENDED', 'REPLACED'
  activatedAt         DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  durationMs          Int?
  reason              String?
  actorId             String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  match               Match       @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  goals               GoalEvent[]
  timerInstances      TimerInstance[]
  goalIntents         GoalIntent[]

  @@unique([matchId, ordinal, attempt])
  @@index([matchId])
}

model GoalEvent {
  id                String          @id
  matchId           String
  segmentAttemptId  String
  side              String          // 'A' | 'B'
  delta             Int             // 1 or -1
  occurredAtMs      Int?
  reason            String?
  actorId           String?
  commandId         String?
  goalIntentId      String?         @unique
  correctsGoalId    String?
  logicalGoalId     String?
  correctionGroupId String?
  createdAt         DateTime        @default(now())
  match             Match           @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  segmentAttempt    SegmentAttempt  @relation(fields: [segmentAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  correctsGoal      GoalEvent?      @relation("GoalCorrection", fields: [correctsGoalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  correctedBy       GoalEvent[]     @relation("GoalCorrection")
  goalIntent        GoalIntent?     @relation(fields: [goalIntentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([matchId])
  @@index([segmentAttemptId])
  @@index([logicalGoalId])
}

model GoalIntent {
  id               String         @id
  matchId          String
  segmentAttemptId String
  status           String         @default("READY") // 'READY', 'CONSUMED', 'INVALIDATED'
  consumedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  match            Match          @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  segmentAttempt   SegmentAttempt @relation(fields: [segmentAttemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  goalEvent        GoalEvent?

  @@index([matchId, status])
  @@index([segmentAttemptId])
}

model ResultRevision {
  id                 String    @id
  matchId            String
  revision           Int       // 1, 2, ...
  status             String    // 'DRAFT', 'FINAL', 'SUPERSEDED'
  decisionText       String?
  winnerTeamId       String?
  finalGoalsA        Int?
  finalGoalsB        Int?
  refereeReference   String?
  authorityReference String?
  reason             String?
  finalizedBy        String?
  finalizedAt        DateTime?
  previousRevisionId String?
  createdAt          DateTime  @default(now())
  match              Match     @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([matchId, revision])
  @@index([matchId])
}

model TimerConfig {
  id          String   @id
  categoryId  String
  phaseType   String   // 'CALLING', 'WARMUP', 'COMPETITION', 'INTERMISSION'
  stageLabel  String?
  initialMs   Int?     // null means not confirmed yet [NEEDS CONFIRMATION]
  approvedBy  String?
  sourceNote  String?
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([categoryId, phaseType])
  @@index([categoryId])
}

model TimerInstance {
  id                  String          @id
  matchId             String
  segmentAttemptId    String?
  type                String          // 'CALLING', 'WARMUP', 'COMPETITION', 'INTERMISSION'
  state               String          @default("IDLE") // 'IDLE', 'RUNNING', 'PAUSED', 'STOPPED', 'EXPIRED', 'RECOVERY_REQUIRED'
  initialMs           Int             // Snapshot from config or command
  remainingAtAnchorMs Int
  anchorWallUtc       DateTime?
  checkpointWallUtc   DateTime?
  runtimeId           String
  checkpointSeq       Int             @default(1)
  timerGeneration     Int             @default(1)
  storageHealth       String          @default("HEALTHY") // 'HEALTHY', 'DEGRADED', 'RECOVERY_PENDING'
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  match               Match           @relation(fields: [matchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  segmentAttempt      SegmentAttempt? @relation(fields: [segmentAttemptId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([matchId])
  @@index([segmentAttemptId])
  @@index([state])
}
