# Template konfigurasi lokal MRC X. Salin menjadi `.env` lalu sesuaikan.
# Semua path relatif terhadap apps/server (cwd script pnpm).

# Wajib. SQLite file protocol; direktori `data/` dibuat otomatis oleh Prisma Migrate.
DATABASE_URL=file:./data/development.db

# Wajib bila frontend Vite (port 5173) memanggil API langsung; Vite tidak memakai proxy.
# Pisahkan dengan koma. Default server hanya mengizinkan http://<HOST>:<PORT>.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Set `true` hanya bila dilayani lewat HTTPS.
COOKIE_SECURE=false

# Opsional. Default 127.0.0.1 dan 3000.
# HOST=127.0.0.1
# PORT=3000

# Kredensial super-admin TIDAK disimpan di file ini.
# Berikan lewat environment saat menjalankan bootstrap:
#   MRC_BOOTSTRAP_ADMIN_USERNAME=superadmin \
#   MRC_BOOTSTRAP_ADMIN_PASSWORD='<minimal 12 karakter>' \
#   pnpm --filter server bootstrap:admin
